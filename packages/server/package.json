{
  "name": "@party-games/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test src/lobby.test.ts src/test/registry-inventory.test.ts",
    "test:contract": "node --import tsx --test src/test/game-contracts.test.ts src/test/games.smoke.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 src/test/**/*.test.ts",
    "test": "pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "@party-games/shared": "workspace:*",
    "partyserver": "^0.5.10"
  },
  "devDependencies": {
    "partysocket": "^1.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
